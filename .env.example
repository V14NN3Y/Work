# --- Postgres ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Used by the backend (asyncpg)
DATABASE_URL=postgresql+asyncpg://ecommerce:change-me@postgres:5432/ecommerce

# --- Backend / JWT / Admin ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Used ONLY once, to seed the very first admin account (migration 0007 inserts a row into the
# `admins` table from these two values). After that, the account lives in the database and is
# changed from the admin dashboard (Paramètres) — editing these here has no effect afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: pre-hash the initial admin password so plaintext never lives in this file.
# When set, ADMIN_PASSWORD_HASH takes priority over ADMIN_PASSWORD for that one-time seed.
#   docker compose exec backend python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=$2b$12$...
CORS_ORIGINS=http://localhost:3001
UPLOAD_DIR=/app/uploads

# --- Frontend ---
# Reached from inside the frontend/backend containers (Docker network)
API_BASE_URL_INTERNAL=http://backend:8000
# Reached from the user's browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public URL of the storefront itself (used for sitemap.xml, robots.txt, Open Graph tags).
# Update to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
