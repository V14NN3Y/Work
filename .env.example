# Local dev reference — copy to .env if you resume local Supabase development
# (`supabase init && supabase start`). Not needed to run the deployed site itself; production
# config lives in Netlify's own environment variables (see .env.production.example).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Printed by `supabase start` — these are the standard local demo keys, safe to keep as-is.
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3001
