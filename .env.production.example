# Production environment template — Supabase + Netlify. Copy to .env.production and fill in
# every value below. Netlify itself does not read this file: paste these into Netlify's
# dashboard (Site settings > Environment variables) or set them via `netlify env:set`. See
# DEPLOY.md.

# --- Supabase (dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
# service_role bypasses Row Level Security entirely — set this ONLY in Netlify's server-side
# environment variables (never NEXT_PUBLIC_-prefixed, never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=change-me

# --- Site ---
# Public URL of the storefront itself (sitemap.xml, robots.txt, Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://oralyah.com

# --- Database password (dashboard > Project Settings > Database) ---
# Needed once for `supabase link` / `supabase db push` from your machine or CI — not read by
# the deployed app itself. Do not commit it, do not paste it into chat.
SUPABASE_DB_PASSWORD=change-me
