# Production environment template. Copy to .env on the server and fill in every value below
# — do not reuse any value from the local .env used for development. See DEPLOY.md.

# --- Domain (used by Caddy for automatic HTTPS — both must already point to this server's IP) ---
DOMAIN=oralyah.com
API_DOMAIN=api.oralyah.com

# --- Postgres ---
POSTGRES_USER=ecommerce
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ecommerce:change-me@postgres:5432/ecommerce

# --- Backend / JWT / Admin ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Used ONLY once, to seed the very first admin account on first deploy (migration 0007).
# After that, change the password from the admin dashboard (Paramètres) — these two values
# are never read again once that row exists.
ADMIN_USERNAME=admin
# Generate: openssl rand -base64 18
ADMIN_PASSWORD=change-me
# Must match the real domain(s) the storefront is served from — browsers reject cross-origin
# API calls otherwise. Comma-separated if you serve both apex and www.
CORS_ORIGINS=https://oralyah.com
UPLOAD_DIR=/app/uploads

# --- Frontend ---
# Reached from inside the frontend/backend containers (Docker network) — leave as-is.
API_BASE_URL_INTERNAL=http://backend:8000
# Reached from the user's browser — must be the real public API domain, over https.
NEXT_PUBLIC_API_BASE_URL=https://api.oralyah.com
# Public URL of the storefront itself (sitemap.xml, robots.txt, Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://oralyah.com
